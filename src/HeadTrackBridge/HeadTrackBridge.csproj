<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- WinExe so double-clicking the player does not also open a black console
         window. The diagnostics are not lost: Program.Main attaches to the
         parent console when there is one, so running it from a terminal still
         prints everything. -->
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>

    <!-- Windows needs a four-part FileVersion, but the version people should
         see is the short one, so both are set rather than derived. Change them
         together. -->
    <Version>0.4</Version>
    <InformationalVersion>0.4</InformationalVersion>
    <Product>VR Flat Player</Product>
    <AssemblyTitle>VR Flat Player</AssemblyTitle>
    <Description>Watch 180/360 VR video on a flat PC monitor, with optional webcam head tracking and hand gestures.</Description>
    <Copyright>GPL-3.0-or-later</Copyright>
    <!-- Only Program.cs enters the message loop; the rest is plain console
         code, so opting out of the implicit Form1 scaffolding. -->
    <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
    <RootNamespace>HeadTrackBridge</RootNamespace>
    <!-- The exe users see. The namespace stays HeadTrackBridge: it is internal,
         and renaming it would churn every file for no user-visible gain. -->
    <AssemblyName>VRFlatPlayer</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Must stay false: with invariant globalization CurrentUICulture is the
         invariant culture, so the OS language detection in Localization.cs
         always resolves to English. -->
    <InvariantGlobalization>false</InvariantGlobalization>
    <!-- GetCursorPos P/Invoke in SyntheticSource is Windows-only. -->
    <SupportedOSPlatform>windows</SupportedOSPlatform>

    <!-- Shell icon: Explorer, the taskbar, the Start menu, file associations.
         Generated by tools/make-icon from assets/icon.svg. -->
    <ApplicationIcon>..\..\assets\icon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- ApplicationIcon only reaches the PE resource table, which Form.Icon
         does not read; without this the window and Alt+Tab would still show
         the stock WinForms icon. Embedding the same file keeps the two from
         drifting apart. -->
    <EmbeddedResource Include="..\..\assets\icon.ico" LogicalName="VRFlatPlayer.icon.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.28.0" />
    <PackageReference Include="OpenCvSharp4" Version="4.13.0.20260627" />
    <PackageReference Include="OpenCvSharp4.runtime.win" Version="4.13.0.20260627" />
  </ItemGroup>

</Project>



